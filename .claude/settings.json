{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test:*)",
      "Bash(pnpm storybook)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f package.json ] && pnpm -s typecheck >/dev/null 2>&1 || [ ! -f package.json ] || { echo 'typecheck failed — run pnpm typecheck' >&2; exit 2; }"
          }
        ]
      }
    ]
  }
}
