{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc-web",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@renderer/*": ["src/renderer/*"] }
  },
  "include": ["src/renderer", "src/renderer/**/*.json", "src/preload/api.d.ts", ".storybook"]
}
